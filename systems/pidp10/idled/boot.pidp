; Simple idle program that rotates a pattern in the PI LEDs
;
; This takes advantage of the simulator's special handling of idle:
; if the instruction & 0740 == 0340 (i.e., an add/subtract and jump)
; and the PC is less than 020, then idle until the next clock tick

echo
echo
echo
echo PiDP-10 boot menu - Set SR switches to select O/S
echo -------------------------------------------------------------------------------
!/opt/pidp10/bin/get_selections.sh .. | column -t -s '	' -o ' ' | column -c 75
echo -------------------------------------------------------------------------------
echo
echo Now running IDLED
echo -------------------------------------------------------------------------------

set on
on sigterm exit

set cpu idle

d -m 4 movei 0,777
d -m 5 datao pi,0
d -m 6 cono apr,1000
d -m 7 conso apr,1000
d -m 10 sojn 2,7
d -m 11 rot 0,-1
d -m 12 jumpa 5

; Because this is the first thing that runs, we don't want to start
; idling right away, or simh's idle calibration will be way off.
; Therefore, we spin briefly before jumping to the low-memory
; idle loop.
d -m 20 hrlzi 0,100
d -m 21 sojn 0,21
d -m 22 jumpa 4

go 20
