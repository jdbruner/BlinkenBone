# make file to build Blinkenlight API sources with "rpcgen"
#
# to be called by client or server makefile
#

# Parameters

# program names
IFNAME=rpc_blinkenlight_api

# RPC API definition file
# lives  in .., is copied here in every rule
IFNAME.x = $(IFNAME).x

# _svc, _clnt, _xdr generated by rpcgen, do not change names!
TARGETS = $(IFNAME).h $(IFNAME)_svc.c  $(IFNAME)_clnt.c $(IFNAME)_xdr.c

# demo; makefile generation doesn't work, so we don't attempt it
TARGETS_SERVERPROCDEMO.c=demo_$(IFNAME)_server_procs.c
TARGETS_CLIENTDEMO.c=demo_$(IFNAME)_client_main.c
TARGETS_MAKEFILEDEMO=demo_makefile

#### As documentation (not built here):
# needed by server
SERVER_OBJECTS=$(IFNAME)_svc.o $(IFNAME)_xdr.o
# needed by client
CLIENT_OBJECTS=$(IFNAME)_clnt.o $(IFNAME)_xdr.o

# -N = new style.
RPCGENFLAGS = -N

# rules - default is to build sources (but not demo)

sources : $(TARGETS)

demo : $(TARGETS_SERVERPROCDEMO.c) $(TARGETS_CLIENTDEMO.c)

all : demo sources

$(IFNAME).h: $(IFNAME.x)
	$(RM) $@
	rpcgen $(RPCGENFLAGS) -h -o $@ $^

$(IFNAME)_svc.c: $(IFNAME.x)
	$(RM) $@
	rpcgen $(RPCGENFLAGS) -m -o $@ $^

$(IFNAME)_clnt.c: $(IFNAME.x)
	$(RM) $@
	rpcgen $(RPCGENFLAGS) -l -o $@ $^

$(IFNAME)_xdr.c: $(IFNAME.x)
	$(RM) $@
	rpcgen $(RPCGENFLAGS) -c -o $@ $^

$(TARGETS_CLIENTDEMO.c): $(IFNAME.x)
	$(RM) $@
	rpcgen $(RPCGENFLAGS) -Sc -o $@ $^

$(TARGETS_SERVERPROCDEMO.c): $(IFNAME.x)
	$(RM) $@
	rpcgen $(RPCGENFLAGS) -Ss -o $@ $^

$(IFNAME.x): ../$(IFNAME.x)
	cp ../$(IFNAME.x) ./$(IFNAME.x)

clean:
	$(RM) core *.c *.h *.x
